gnew() {
  if [[ -z "$1" ]]; then
    echo "usage: gnew <new-branch> [base=main]" >&2
    return 1
  fi
  local base="${2:-main}"
  git switch "$base" && git up && git switch -c "$1"
}

gwl() {
  git worktree list
}

gwnew() {
  if [[ -z "$1" ]]; then
    echo "usage: gwnew <new-branch> [base=main]" >&2
    return 1
  fi

  local branch="$1"
  local base="${2:-main}"
  local root repo parent worktree_path safe_branch

  root="$(git rev-parse --show-toplevel)" || return 1
  repo="$(basename "$root")"
  parent="$(dirname "$root")"
  safe_branch="${branch//\//-}"
  worktree_path="$parent/$repo-$safe_branch"

  git fetch origin "$base" &&
  git worktree add -b "$branch" "$worktree_path" "origin/$base" &&
  cd "$worktree_path"
}

gwgo() {
  local query="$1"
  local selection worktree_path

  if [[ -z "$query" ]]; then
    if ! command -v fzf >/dev/null 2>&1; then
      echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
      git worktree list
      return 1
    fi

    selection="$(
      git worktree list --porcelain |
      awk '
        function emit() {
          if (wt != "") {
            printf "%s\t%s\n", branch, wt
          }
        }
        /^worktree / {
          emit()
          wt = substr($0, 10)
          branch = "(detached)"
        }
        /^branch / {
          branch = $2
          sub(/^refs\/heads\//, "", branch)
        }
        END { emit() }
      ' |
      fzf --delimiter=$'\t' --with-nth=1,2 --prompt="worktree> "
    )" || return 1

    worktree_path="${selection#*$'\t'}"
  else
    worktree_path="$(
      git worktree list --porcelain |
      awk -v q="$query" '
        /^worktree / { wt = substr($0, 10) }
        /^branch / {
          branch = $2
          sub(/^refs\/heads\//, "", branch)
          if (branch == q || wt == q || wt ~ "/" q "$") {
            print wt
            exit
          }
        }
      '
    )"

    if [[ -z "$worktree_path" ]]; then
      echo "no worktree found for: $query" >&2
      git worktree list
      return 1
    fi
  fi

  cd "$worktree_path"
}

gbgo() {
  local selection branch

  if [[ $# -ne 0 ]]; then
    echo "usage: gbgo" >&2
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
    git branch --sort=-committerdate
    return 1
  fi

  selection="$(
    git for-each-ref --sort=-committerdate --format='%(refname:short)%09%(committerdate:relative)%09%(subject)' refs/heads |
    fzf --delimiter=$'\t' --with-nth=1,2,3 --prompt="branch> "
  )" || return 1

  branch="${selection%%$'\t'*}"
  git switch "$branch"
}

gsl() {
  git stash list --format='%gd%x09%cr%x09%gs'
}

gss() {
  if [[ $# -eq 0 ]]; then
    git stash push -u
  else
    git stash push -u -m "$*"
  fi
}

_gstash_pick() {
  local selection

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
    gsl
    return 1
  fi

  selection="$(
    gsl |
    fzf --delimiter=$'\t' --with-nth=1,2,3 --prompt="stash> " --preview='git stash show --patch --color=always {1} | delta --paging=never --line-numbers --hunk-header-style=omit' --preview-window=down,60%
  )" || return 1

  printf '%s\n' "${selection%%$'\t'*}"
}

gsa() {
  local stash
  stash="$(_gstash_pick)" || return 1
  git stash apply "$stash"
}

gsp() {
  local stash
  stash="$(_gstash_pick)" || return 1
  git stash pop "$stash"
}

gsshow() {
  local stash
  stash="$(_gstash_pick)" || return 1
  git stash show --patch --color=always "$stash" | delta --paging=never --line-numbers --hunk-header-style=omit
}

gsd() {
  local stash answer
  stash="$(_gstash_pick)" || return 1

  printf 'drop %s? [y/N] ' "$stash" >&2
  read -r answer
  if [[ "$answer" == [yY] ]]; then
    git stash drop "$stash"
  fi
}

gwrm() {
  if [[ -z "$1" ]]; then
    echo "usage: gwrm <path>" >&2
    return 1
  fi

  git worktree remove "$1"
}

gup() {
  if [[ -z "$1" ]]; then
    echo "usage: gup <branch>" >&2
    return 1
  fi

  git switch "$1" && git up
}

grebase() {
  local interactive target current
  interactive=0

  if [[ "$1" == "-i" ]]; then
    interactive=1
    shift
  fi

  target="$1"

  if [[ -z "$target" ]]; then
    echo "usage: grebase [-i] <branch>" >&2
    return 1
  fi

  current="$(git branch --show-current)" || return 1

  if [[ "$current" == "$target" ]]; then
    echo "already on $target" >&2
    return 1
  fi

  git switch "$target" &&
  git up &&
  git switch "$current" &&
  if (( interactive )); then
    git rebase -i "$target"
  else
    git rebase "$target"
  fi &&
  echo "Rebase finished. If this branch was previously pushed, use: git push --force-with-lease"
}
