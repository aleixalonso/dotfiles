gnew() {
  if [[ -z "$1" ]]; then
    echo "usage: gnew <new-branch> [base=main]" >&2
    return 1
  fi
  local base="${2:-main}"
  git switch "$base" && git up && git switch -c "$1"
}

gwl() {
  git worktree list
}

gwnew() {
  if [[ -z "$1" ]]; then
    echo "usage: gwnew <new-branch> [base=main]" >&2
    return 1
  fi

  local branch="$1"
  local base="${2:-main}"
  local root repo parent path safe_branch

  root="$(git rev-parse --show-toplevel)" || return 1
  repo="$(basename "$root")"
  parent="$(dirname "$root")"
  safe_branch="${branch//\//-}"
  path="$parent/$repo-$safe_branch"

  git fetch origin "$base" &&
  git worktree add -b "$branch" "$path" "origin/$base" &&
  cd "$path"
}

gwrm() {
  if [[ -z "$1" ]]; then
    echo "usage: gwrm <path>" >&2
    return 1
  fi

  git worktree remove "$1"
}

gup() {
  if [[ -z "$1" ]]; then
    echo "usage: gup <branch>" >&2
    return 1
  fi

  git switch "$1" && git up
}

grebase() {
  local interactive target current
  interactive=0

  if [[ "$1" == "-i" ]]; then
    interactive=1
    shift
  fi

  target="$1"

  if [[ -z "$target" ]]; then
    echo "usage: grebase [-i] <branch>" >&2
    return 1
  fi

  current="$(git branch --show-current)" || return 1

  if [[ "$current" == "$target" ]]; then
    echo "already on $target" >&2
    return 1
  fi

  git switch "$target" &&
  git up &&
  git switch "$current" &&
  if (( interactive )); then
    git rebase -i "$target"
  else
    git rebase "$target"
  fi &&
  echo "Rebase finished. If this branch was previously pushed, use: git push --force-with-lease"
}
