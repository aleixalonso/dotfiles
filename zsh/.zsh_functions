gbnew() {
  if [[ -z "$1" ]]; then
    echo "usage: gbnew <new-branch> [base=main]" >&2
    return 1
  fi
  local branch="$1"
  local base="${2:-main}"
  git fetch origin "$base" && git switch -c "$branch" "origin/$base"
}

_gbranch_list() {
  local branch updated subject description summary display_branch

  git for-each-ref --sort=-committerdate --format='%(refname:short)%09%(committerdate:relative)%09%(subject)' refs/heads |
  while IFS=$'\t' read -r branch updated subject; do
    description="$(git config --get "branch.$branch.description")"
    summary="${description:-$subject}"
    display_branch="$branch"
    if (( ${#display_branch} > 24 )); then
      display_branch="${display_branch[1,21]}..."
    fi
    printf '%-24s  %-14s  %s\t%s\t%s\t%s\t%s\n' "$display_branch" "$updated" "$summary" "$branch" "$branch" "$updated" "$summary"
  done
}

_gbranch_pick() {
  local branches selection
  local prompt="${1:-branch> }"

  branches="$(_gbranch_list)" || return 1
  if [[ -z "$branches" ]]; then
    echo "no branches found" >&2
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
    git branch --sort=-committerdate
    return 1
  fi

  selection="$(
    printf '%s\n' "$branches" |
    fzf --delimiter=$'\t' --with-nth=1 --prompt="$prompt" --preview='printf "%s\n%s\n" {3} {5}' --preview-window=down,3,wrap
  )" || return 1

  selection="${selection#*$'\t'}"
  printf '%s\n' "${selection%%$'\t'*}"
}

gbgo() {
  local current branches branch

  if [[ $# -ne 0 ]]; then
    echo "usage: gbgo" >&2
    return 1
  fi

  current="$(git branch --show-current)" || return 1
  branches="$(_gbranch_list)" || return 1
  if [[ -z "$(printf '%s\n' "$branches" | awk -F '\t' -v current="$current" '$2 != current { print; exit }')" ]]; then
    echo "no other branches found" >&2
    return 1
  fi

  branch="$(_gbranch_pick "switch branch> ")" || return 1
  git switch "$branch"
}

_gbranch_pick_removable() {
  local current branches selection

  current="$(git branch --show-current)" || return 1
  branches="$(_gbranch_list | awk -F '\t' -v current="$current" '$1 != current')" || return 1

  if [[ -z "$branches" ]]; then
    echo "no removable branches found" >&2
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
    printf '%s\n' "$branches"
    return 1
  fi

  selection="$(
    printf '%s\n' "$branches" |
    fzf --delimiter=$'\t' --with-nth=1 --prompt="remove branch> " --preview='printf "%s\n%s\n" {3} {5}' --preview-window=down,3,wrap
  )" || return 1

  selection="${selection#*$'\t'}"
  printf '%s\n' "${selection%%$'\t'*}"
}

gbrm() {
  local branch answer

  if [[ -z "$1" ]]; then
    branch="$(_gbranch_pick_removable)" || return 1
  else
    branch="$1"
  fi

  if [[ "$branch" == "$(git branch --show-current)" ]]; then
    echo "cannot remove current branch: $branch" >&2
    return 1
  fi

  printf 'remove %s? [y/N] ' "$branch" >&2
  read -r answer
  if [[ "$answer" == [yY] ]]; then
    git branch -d "$branch"
  fi
}

gbdesc() {
  local branch="${1:-$(git branch --show-current)}"

  if [[ -z "$branch" ]]; then
    echo "usage: gbdesc [branch]" >&2
    return 1
  fi

  if ! git show-ref --verify --quiet "refs/heads/$branch"; then
    echo "no local branch found: $branch" >&2
    return 1
  fi

  git branch --edit-description "$branch"
}

gup() {
  if [[ -z "$1" ]]; then
    echo "usage: gup <branch>" >&2
    return 1
  fi

  git switch "$1" && git up
}

grebase() {
  local interactive target current
  interactive=0

  if [[ "$1" == "-i" ]]; then
    interactive=1
    shift
  fi

  target="$1"

  if [[ -z "$target" ]]; then
    echo "usage: grebase [-i] <branch>" >&2
    return 1
  fi

  current="$(git branch --show-current)" || return 1

  if [[ "$current" == "$target" ]]; then
    echo "already on $target" >&2
    return 1
  fi

  git switch "$target" &&
  git up &&
  git switch "$current" &&
  if (( interactive )); then
    git rebase -i "$target"
  else
    git rebase "$target"
  fi &&
  echo "Rebase finished. If this branch was previously pushed, use: git push --force-with-lease"
}

gmerge() {
  local target current
  target="$1"

  if [[ -z "$target" ]]; then
    echo "usage: gmerge <branch>" >&2
    return 1
  fi

  current="$(git branch --show-current)" || return 1

  if [[ "$current" == "$target" ]]; then
    echo "already on $target" >&2
    return 1
  fi

  git switch "$target" &&
  git up &&
  git switch "$current" &&
  git merge "$target" &&
  echo "Merge finished."
}

gwl() {
  git worktree list
}

_gworktree_setup_dirs() {
  local source_root="$1"
  local dir rel env_file has_env has_project_marker
  local -a candidates env_files setup_dirs

  candidates=("$source_root" "$source_root"/*(/N) "$source_root"/*/*(/N))

  for dir in "${candidates[@]}"; do
    rel="${dir#$source_root/}"
    [[ "$dir" == "$source_root" ]] && rel="."

    case "$rel" in
      .git|.git/*|*/.git|*/.git/*|node_modules|node_modules/*|*/node_modules|*/node_modules/*)
        continue
        ;;
    esac

    has_project_marker=0
    if [[ -f "$dir/package.json" ||
          -f "$dir/pnpm-lock.yaml" ||
          -f "$dir/yarn.lock" ||
          -f "$dir/bun.lock" ||
          -f "$dir/bun.lockb" ||
          -f "$dir/package-lock.json" ||
          -f "$dir/npm-shrinkwrap.json" ]]; then
      has_project_marker=1
    fi

    has_env=0
    env_files=("$dir"/.env(N.) "$dir"/.env.*(N.))
    for env_file in "${env_files[@]}"; do
      case "$(basename "$env_file")" in
        .env.example|.env.sample|.env.template)
          continue
          ;;
      esac
      has_env=1
      break
    done

    if (( has_project_marker || has_env )); then
      setup_dirs+=("$rel")
    fi
  done

  printf '%s\n' "${setup_dirs[@]}"
}

_gworktree_copy_env_files() {
  local source_root="$1"
  local target_root="$2"
  shift 2
  local setup_dir source_dir target_dir env_file target copied skipped
  local -a env_files setup_dirs

  copied=0
  skipped=0
  setup_dirs=("$@")

  for setup_dir in "${setup_dirs[@]}"; do
    if [[ "$setup_dir" == "." ]]; then
      source_dir="$source_root"
      target_dir="$target_root"
    else
      source_dir="$source_root/$setup_dir"
      target_dir="$target_root/$setup_dir"
    fi

    [[ -d "$target_dir" ]] || continue

    env_files=("$source_dir"/.env(N.) "$source_dir"/.env.*(N.))
    for env_file in "${env_files[@]}"; do
      case "$(basename "$env_file")" in
        .env.example|.env.sample|.env.template)
          continue
          ;;
      esac

      target="$target_dir/$(basename "$env_file")"
      if [[ -e "$target" ]]; then
        skipped=$((skipped + 1))
        continue
      fi

      cp -p "$env_file" "$target" || return 1
      copied=$((copied + 1))
    done
  done

  if (( copied > 0 )); then
    echo "copied $copied env file(s)"
  fi
  if (( skipped > 0 )); then
    echo "skipped $skipped existing env file(s)"
  fi
}

_gworktree_install_deps() {
  local worktree_path="$1"
  shift
  local setup_dir install_dir manager
  local -a setup_dirs
  local -a install_args

  setup_dirs=("$@")

  for setup_dir in "${setup_dirs[@]}"; do
    if [[ "$setup_dir" == "." ]]; then
      install_dir="$worktree_path"
    else
      install_dir="$worktree_path/$setup_dir"
    fi

    [[ -f "$install_dir/package.json" ]] || continue

    if [[ -f "$install_dir/pnpm-lock.yaml" ]]; then
      manager="pnpm"
      install_args=(install)
    elif [[ -f "$install_dir/yarn.lock" ]]; then
      manager="yarn"
      install_args=(install)
    elif [[ -f "$install_dir/bun.lock" || -f "$install_dir/bun.lockb" ]]; then
      manager="bun"
      install_args=(install)
    elif [[ -f "$install_dir/package-lock.json" || -f "$install_dir/npm-shrinkwrap.json" ]]; then
      manager="npm"
      install_args=(install)
    else
      echo "skipping dependency install in $setup_dir: no lockfile found" >&2
      continue
    fi

    if ! command -v "$manager" >/dev/null 2>&1; then
      echo "skipping dependency install in $setup_dir: $manager is not available" >&2
      continue
    fi

    echo "installing dependencies in $setup_dir with $manager"
    (cd "$install_dir" && "$manager" "${install_args[@]}") || return 1
  done
}

_gworktree_list() {
  local exclude_current="${1:-0}"
  local exclude_primary="${2:-0}"
  local current

  if [[ "$exclude_current" == "1" ]]; then
    current="$(git rev-parse --show-toplevel)" || return 1
  fi

  git worktree list --porcelain |
  awk -v current="$current" -v exclude_current="$exclude_current" -v exclude_primary="$exclude_primary" '
    function truncate(value, width) {
      if (length(value) > width) {
        return substr(value, 1, width - 3) "..."
      }
      return value
    }
    function emit() {
      if (wt != "" && !(exclude_current == "1" && wt == current) && !(exclude_primary == "1" && wt == primary)) {
        display_branch = truncate(branch, 24)
        description = ""
        command = "git config --get branch." branch ".description"
        if ((command | getline description) <= 0) {
          description = ""
        }
        close(command)
        subject = ""
        if (description == "") {
          command = "git log -1 --format=%s " branch
          if ((command | getline subject) <= 0) {
            subject = ""
          }
          close(command)
        }
        summary = description != "" ? description : subject
        printf "%-24s  %s\t%s\t%s\t%s\n", display_branch, wt, wt, branch, summary
      }
    }
    /^worktree / {
      emit()
      wt = substr($0, 10)
      if (primary == "") {
        primary = wt
      }
      branch = "(detached)"
    }
    /^branch / {
      branch = $2
      sub(/^refs\/heads\//, "", branch)
    }
    END { emit() }
  '
}

_gworktree_create() {
  local source_root="$1"
  local worktree_path="$2"
  local branch="$3"
  local base="${4:-main}"
  local setup_status setup_dirs_output setup_dir
  local -a setup_dirs
  local -A seen_setup_dirs

  if git -C "$source_root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$source_root" worktree add "$worktree_path" "$branch"
  elif git -C "$source_root" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    git -C "$source_root" fetch origin "$branch" &&
    git -C "$source_root" worktree add --track -b "$branch" "$worktree_path" "origin/$branch"
  else
    git -C "$source_root" fetch origin "$base" &&
    git -C "$source_root" worktree add -b "$branch" "$worktree_path" "origin/$base"
  fi || return 1

  setup_dirs_output="$(
    _gworktree_setup_dirs "$source_root"
    _gworktree_setup_dirs "$worktree_path"
  )"
  for setup_dir in "${(@f)setup_dirs_output}"; do
    [[ -n "$setup_dir" && -z "${seen_setup_dirs[$setup_dir]}" ]] || continue
    seen_setup_dirs[$setup_dir]=1
    setup_dirs+=("$setup_dir")
  done

  _gworktree_copy_env_files "$source_root" "$worktree_path" "${setup_dirs[@]}"
  setup_status=$?
  if (( setup_status == 0 )); then
    _gworktree_install_deps "$worktree_path" "${setup_dirs[@]}"
    setup_status=$?
  fi

  return "$setup_status"
}

gwnew() {
  local branch="$1"
  local base="${2:-main}"
  local root primary_root repo parent worktree_path safe_branch existing_worktree setup_status

  if [[ -z "$branch" ]]; then
    branch="$(_gbranch_pick "new worktree branch> ")" || return 1
  fi

  root="$(git rev-parse --show-toplevel)" || return 1
  primary_root="$(
    git worktree list --porcelain |
    awk '/^worktree / { print substr($0, 10); exit }'
  )" || return 1
  repo="$(basename "$primary_root")"
  parent="$(dirname "$primary_root")"
  safe_branch="${branch//\//-}"
  worktree_path="$parent/$repo-$safe_branch"
  existing_worktree="$(
    git worktree list --porcelain |
    awk -v q="$branch" '
      /^worktree / { wt = substr($0, 10) }
      /^branch / {
        branch = $2
        sub(/^refs\/heads\//, "", branch)
        if (branch == q) {
          print wt
          exit
        }
      }
    '
  )"

  if [[ -n "$existing_worktree" ]]; then
    cd "$existing_worktree"
    return
  fi

  _gworktree_create "$root" "$worktree_path" "$branch" "$base"
  setup_status=$?

  cd "$worktree_path" || return 1
  return "$setup_status"
}

gwgo() {
  local query="$1"
  local worktrees selection worktree_path
  local -a worktree_lines

  if [[ -z "$query" ]]; then
    worktrees="$(_gworktree_list 0 0)" || return 1
    worktree_lines=("${(@f)worktrees}")
    if (( ${#worktree_lines} < 2 )); then
      echo "no other worktrees found" >&2
      return 1
    fi

    if ! command -v fzf >/dev/null 2>&1; then
      echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
      git worktree list
      return 1
    fi

    selection="$(
      printf '%s\n' "$worktrees" |
      fzf --delimiter=$'\t' --with-nth=1 --prompt="switch worktree> " --preview='printf "%s\n%s\n%s\n\n" {3} {4} {2}; git -C {2} status --short --branch' --preview-window=down,60%,wrap
    )" || return 1

    worktree_path="${selection#*$'\t'}"
    worktree_path="${worktree_path%%$'\t'*}"
  else
    worktree_path="$(
      git worktree list --porcelain |
      awk -v q="$query" '
        /^worktree / { wt = substr($0, 10) }
        /^branch / {
          branch = $2
          sub(/^refs\/heads\//, "", branch)
          if (branch == q || wt == q || wt ~ "/" q "$") {
            print wt
            exit
          }
        }
      '
    )"

    if [[ -z "$worktree_path" ]]; then
      echo "no worktree found for: $query" >&2
      git worktree list
      return 1
    fi
  fi

  cd "$worktree_path"
}

_gworktree_pick() {
  local worktrees selection

  worktrees="$(_gworktree_list 1 1)" || return 1

  if [[ -z "$worktrees" ]]; then
    echo "no removable worktrees found" >&2
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
    git worktree list
    return 1
  fi

  selection="$(
    printf '%s\n' "$worktrees" |
    fzf --delimiter=$'\t' --with-nth=1 --prompt="remove worktree> " --preview='printf "%s\n%s\n%s\n\n" {3} {4} {2}; git -C {2} status --short --branch' --preview-window=down,60%,wrap
  )" || return 1

  selection="${selection#*$'\t'}"
  printf '%s\n' "${selection%%$'\t'*}"
}

gwrm() {
  local worktree_path answer

  if [[ -z "$1" ]]; then
    worktree_path="$(_gworktree_pick)" || return 1
  else
    worktree_path="$1"
  fi

  printf 'remove %s? [y/N] ' "$worktree_path" >&2
  read -r answer
  if [[ "$answer" == [yY] ]]; then
    git worktree remove "$worktree_path"
  fi
}

_workspace_root() {
  local dir="${1:-$PWD}"

  dir="${dir:A}"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.workspace" ]]; then
      printf '%s\n' "$dir"
      return
    fi
    dir="${dir:h}"
  done

  return 1
}

_workspace_value() {
  local workspace_root="$1"
  local key="$2"

  awk -F '\t' -v key="$key" '$1 == key { print $2; exit }' "$workspace_root/.workspace"
}

_workspace_project_root() {
  local dir="${1:-$PWD}"
  local workspace_root

  if workspace_root="$(_workspace_root "$dir")"; then
    _workspace_value "$workspace_root" project_root
    return
  fi

  dir="${dir:A}"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/workspaces" ]]; then
      printf '%s\n' "$dir"
      return
    fi
    dir="${dir:h}"
  done

  return 1
}

_workspace_repo_list() {
  local project_root="$1"
  local dir repo_root

  for dir in "$project_root"/*(/N); do
    [[ "${dir:t}" == "workspaces" ]] && continue
    repo_root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || continue
    [[ "${repo_root:A}" == "${dir:A}" ]] || continue
    printf '%s\t%s\n' "${dir:t}" "$dir"
  done
}

_workspace_repo_pick() {
  local project_root="$1"
  local repos selection

  repos="$(_workspace_repo_list "$project_root")"
  if [[ -z "$repos" ]]; then
    echo "no Git repositories found directly under $project_root" >&2
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
    printf '%s\n' "$repos"
    return 1
  fi

  selection="$(printf '%s\n' "$repos" | fzf --delimiter=$'\t' --with-nth=1 --prompt="add repository> ")" || return 1
  printf '%s\n' "${selection%%$'\t'*}"
}

_workspace_template_dir() {
  local template_dir="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/workspace-templates"

  if [[ ! -d "$template_dir" ]]; then
    echo "workspace templates not found: $template_dir" >&2
    echo "rerun the dotfiles installer" >&2
    return 1
  fi

  printf '%s\n' "$template_dir"
}

_workspace_render_template() {
  local source="$1"
  local target="$2"
  local workspace_name="$3"
  local line

  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "${line//\{\{WORKSPACE_NAME\}\}/$workspace_name}"
  done < "$source" > "$target"
}

wsnew() {
  local workspace_name="$1"
  local project_root workspace_root template_dir template

  if [[ -z "$workspace_name" || "$workspace_name" == */* ]]; then
    echo "usage: wsnew <workspace>" >&2
    return 1
  fi

  project_root="${PWD:A}"
  workspace_root="$project_root/workspaces/$workspace_name"
  template_dir="$(_workspace_template_dir)" || return 1

  if [[ -e "$workspace_root" ]]; then
    if [[ -f "$workspace_root/.workspace" ]]; then
      cd "$workspace_root"
      return
    fi
    echo "path already exists and is not a workspace: $workspace_root" >&2
    return 1
  fi

  mkdir -p "$workspace_root" || return 1
  printf 'project_root\t%s\nworkspace_name\t%s\n' "$project_root" "$workspace_name" > "$workspace_root/.workspace"
  for template in AGENTS.md WORKSPACE.md DECISIONS.md STATUS.md; do
    _workspace_render_template "$template_dir/$template" "$workspace_root/$template" "$workspace_name" || return 1
  done

  cd "$workspace_root"
}

wsadd() {
  local repo_name="$1"
  local branch="$2"
  local base="${3:-main}"
  local workspace_root project_root source_root worktree_path setup_status

  workspace_root="$(_workspace_root)" || {
    echo "wsadd must be run from inside a workspace" >&2
    return 1
  }
  project_root="$(_workspace_value "$workspace_root" project_root)" || return 1

  if [[ -z "$repo_name" ]]; then
    repo_name="$(_workspace_repo_pick "$project_root")" || return 1
  fi
  if [[ "$repo_name" == */* ]]; then
    echo "repository must be a direct child name, not a path: $repo_name" >&2
    return 1
  fi

  source_root="$project_root/$repo_name"
  if [[ "$(git -C "$source_root" rev-parse --show-toplevel 2>/dev/null)" != "${source_root:A}" ]]; then
    echo "not a Git repository: $source_root" >&2
    return 1
  fi

  if [[ -z "$branch" ]]; then
    printf 'branch> ' >&2
    read -r branch
  fi
  if [[ -z "$branch" ]]; then
    echo "branch is required" >&2
    return 1
  fi

  worktree_path="$workspace_root/$repo_name"
  if [[ -e "$worktree_path" ]]; then
    echo "workspace repository already exists: $worktree_path" >&2
    return 1
  fi

  _gworktree_create "$source_root" "$worktree_path" "$branch" "$base"
  setup_status=$?
  return "$setup_status"
}

_workspace_list() {
  local project_root="$1"
  local dir

  for dir in "$project_root"/workspaces/*(/N); do
    [[ -f "$dir/.workspace" ]] || continue
    printf '%s\t%s\n' "${dir:t}" "$dir"
  done
}

wslist() {
  local project_root workspaces

  project_root="$(_workspace_project_root)" || {
    echo "no workspace project root found" >&2
    return 1
  }
  workspaces="$(_workspace_list "$project_root")"
  if [[ -z "$workspaces" ]]; then
    echo "no workspaces found under $project_root" >&2
    return 1
  fi
  printf '%s\n' "$workspaces" | column -t -s $'\t'
}

wsgo() {
  local query="$1"
  local project_root workspaces selection workspace_path

  project_root="$(_workspace_project_root)" || {
    echo "no workspace project root found" >&2
    return 1
  }
  workspaces="$(_workspace_list "$project_root")"
  if [[ -z "$workspaces" ]]; then
    echo "no workspaces found under $project_root" >&2
    return 1
  fi

  if [[ -z "$query" ]]; then
    if ! command -v fzf >/dev/null 2>&1; then
      echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
      wslist
      return 1
    fi
    selection="$(printf '%s\n' "$workspaces" | fzf --delimiter=$'\t' --with-nth=1 --prompt="switch workspace> ")" || return 1
    workspace_path="${selection#*$'\t'}"
  else
    workspace_path="$(printf '%s\n' "$workspaces" | awk -F '\t' -v query="$query" '$1 == query { print $2; exit }')"
    if [[ -z "$workspace_path" ]]; then
      echo "no workspace found for: $query" >&2
      wslist
      return 1
    fi
  fi

  cd "$workspace_path"
}

wsstatus() {
  local workspace_root dir branch repo_status

  workspace_root="$(_workspace_root)" || {
    echo "wsstatus must be run from inside a workspace" >&2
    return 1
  }

  {
    printf 'WORKSPACE\t%s\n' "$(_workspace_value "$workspace_root" workspace_name)"
    for dir in "$workspace_root"/*(/N); do
      git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || continue
      branch="$(git -C "$dir" branch --show-current)"
      repo_status="$(git -c status.branch=false -C "$dir" status --short)"
      [[ -n "$repo_status" ]] && repo_status="modified" || repo_status="clean"
      printf '%s\t%s\t%s\n' "${dir:t}" "${branch:-(detached)}" "$repo_status"
    done
  } | column -t -s $'\t'
}

gsl() {
  git stash list --format='%gd%x09%cr%x09%gs'
}

gsm() {
  if [[ $# -eq 0 ]]; then
    echo "usage: gsm <message>" >&2
    return 1
  fi

  git stash push -u -m "$*"
}

_gstash_pick() {
  local stashes selection
  local prompt="${1:-stash> }"

  stashes="$(gsl)" || return 1
  if [[ -z "$stashes" ]]; then
    echo "no stashes found" >&2
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install it with: brew install fzf" >&2
    gsl
    return 1
  fi

  selection="$(
    printf '%s\n' "$stashes" |
    fzf --delimiter=$'\t' --with-nth=1,2,3 --prompt="$prompt" --preview='printf "%s  %s\n%s\n" {1} {2} {3}; git stash show --patch --color=always {1} | delta --paging=never --line-numbers --hunk-header-style=omit' --preview-window=down,60%,wrap
  )" || return 1

  printf '%s\n' "${selection%%$'\t'*}"
}

gsa() {
  local stash
  stash="$(_gstash_pick "apply stash> ")" || return 1
  git stash apply "$stash"
}

gsp() {
  local stash
  stash="$(_gstash_pick "pop stash> ")" || return 1
  git stash pop "$stash"
}

gss() {
  local stash
  stash="$(_gstash_pick "show stash> ")" || return 1
  git stash show --patch --color=always "$stash" | delta --paging=always --line-numbers --hunk-header-style=omit
}

gsd() {
  local stash answer
  stash="$(_gstash_pick "drop stash> ")" || return 1

  printf 'drop %s? [y/N] ' "$stash" >&2
  read -r answer
  if [[ "$answer" == [yY] ]]; then
    git stash drop "$stash"
  fi
}

_sleep_disabled_value() {
  pmset -g 2>/dev/null |
  awk '/^[[:space:]]*SleepDisabled[[:space:]]/ { print $2; found = 1 } END { if (!found) print "0" }'
}

_keepawake_status() {
  local value

  value="$(_sleep_disabled_value)"
  case "$value" in
    1) echo "SleepDisabled = 1 (sleep disabled)" ;;
    0) echo "SleepDisabled = 0 (sleep enabled)" ;;
    *) echo "SleepDisabled = unknown" ;;
  esac
}

_keepawake_setup() {
  local file="/etc/sudoers.d/pmset-sleep"
  local temp
  local rule

  [[ -f "$file" ]] && return 0

  temp="$(mktemp -t pmset-sleep)" || return 1
  rule="$(whoami) ALL=(ALL) NOPASSWD: /usr/bin/pmset disablesleep *"
  printf '%s\n' "$rule" > "$temp" || return 1

  if ! visudo -cf "$temp" >/dev/null; then
    rm -f "$temp"
    echo "sudoers rule failed validation" >&2
    return 1
  fi

  echo "installing sudoers rule for passwordless pmset disablesleep"
  sudo install -o root -g wheel -m 0440 "$temp" "$file"
  local install_status=$?
  rm -f "$temp"
  return "$install_status"
}

_keepawake_usage() {
  echo "usage: keepawake [--setup] [--status|--on|--off|command ...]" >&2
}

keepawake() {
  local previous exit_status
  local setup=0
  local mode=""

  while (( $# > 0 )); do
    case "$1" in
      --setup)
        setup=1
        shift
        ;;
      --status|--on|--off)
        mode="$1"
        shift
        break
        ;;
      --help)
        _keepawake_usage
        return
        ;;
      --)
        shift
        break
        ;;
      --*)
        echo "unknown option: $1" >&2
        _keepawake_usage
        return 1
        ;;
      *)
        break
        ;;
    esac
  done

  if (( setup )); then
    _keepawake_setup || return 1
    if [[ -z "$mode" && $# -eq 0 ]]; then
      echo "persistent sudoers rule installed"
      _keepawake_status
      return
    fi
  fi

  case "$mode" in
    --status)
      if (( $# != 0 )); then
        _keepawake_usage
        return 1
      fi
      _keepawake_status
      return
      ;;
    --on)
      if (( $# != 0 )); then
        _keepawake_usage
        return 1
      fi
      sudo pmset disablesleep 1 || return 1
      _keepawake_status
      return
      ;;
    --off)
      if (( $# != 0 )); then
        _keepawake_usage
        return 1
      fi
      sudo pmset disablesleep 0 || return 1
      _keepawake_status
      return
      ;;
  esac

  previous="$(_sleep_disabled_value)"
  sudo pmset disablesleep 1 || return 1
  echo "lid-close sleep disabled; Ctrl-C to restore"

  {
    if (( $# > 0 )); then
      "$@"
    else
      echo "keeping awake until Ctrl-C"
      while true; do
        sleep 3600
      done
    fi
  } always {
    exit_status=$?
    sudo pmset disablesleep "$previous"
    echo "SleepDisabled restored to $previous"
    return "$exit_status"
  }
}
