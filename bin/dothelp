#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local path="${BASH_SOURCE[0]}"
  local dir target

  while [[ -L "$path" ]]; do
    dir="$(cd "$(dirname "$path")" && pwd)"
    target="$(readlink "$path")"
    if [[ "$target" == /* ]]; then
      path="$target"
    else
      path="$dir/$target"
    fi
  done

  cd "$(dirname "$path")" && pwd
}

usage() {
  printf '%s\n' \
    "usage: dothelp [query]" \
    "       dothelp --pick" \
    "" \
    "List custom dotfiles commands, filter them by text, or browse with fzf."
}

command_catalog() {
  local readme="$1"

  awk '
    /^## Git shortcuts$/ { active = 1; next }
    /^## macOS defaults$/ { active = 0 }
    !active { next }
    /^### / || /^#### / {
      category = $0
      sub(/^#+[[:space:]]+/, "", category)
      next
    }
    /^- `[^`]+`/ {
      line = $0
      sub(/^- `/, "", line)
      split(line, parts, "`")
      command = parts[1]
      description = line
      sub(/^[^`]+`[^[:alnum:]]*/, "", description)
      printf "%s\t%s\t%s\n", category, command, description
    }
  ' "$readme"
}

format_catalog() {
  local width

  width="$(tput cols 2>/dev/null || printf '100')"
  (( width > 120 )) && width=120
  (( width < 60 )) && width=60

  awk -F '\t' -v width="$width" '
    {
      category[NR] = $1
      command[NR] = $2
      description[NR] = $3
      if (length($2) > command_width) {
        command_width = length($2)
      }
    }
    END {
      if (command_width > width - 28) {
        command_width = width - 28
      }
      description_width = width - command_width - 6

      for (row = 1; row <= NR; row++) {
        if (category[row] != previous_category) {
          if (previous_category != "") {
            print ""
          }
          print category[row]
          previous_category = category[row]
        }

        if (length(command[row]) > command_width) {
          print "  " command[row]
          prefix = sprintf("    %-*s", command_width, "")
        } else {
          prefix = sprintf("  %-*s  ", command_width, command[row])
        }

        count = split(description[row], words, /[[:space:]]+/)
        line = ""
        for (word = 1; word <= count; word++) {
          if (line == "") {
            line = words[word]
          } else if (length(line) + length(words[word]) + 1 <= description_width) {
            line = line " " words[word]
          } else {
            print prefix line
            prefix = sprintf("    %-*s", command_width, "")
            line = words[word]
          }
        }
        print prefix line
      }
    }
  '
}

main() {
  local script_dir dotfiles_dir readme query catalog selection

  script_dir="$(resolve_script_path)"
  dotfiles_dir="$(cd "$script_dir/.." && pwd)"
  readme="$dotfiles_dir/README.md"

  if [[ ! -f "$readme" ]]; then
    echo "dotfiles README not found: $readme" >&2
    exit 1
  fi

  case "${1:-}" in
    -h|--help)
      usage
      return
      ;;
    --pick)
      if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf is required for --pick" >&2
        exit 1
      fi
      catalog="$(command_catalog "$readme")"
      selection="$(printf '%s\n' "$catalog" | fzf --delimiter=$'\t' --with-nth=2,3 --prompt='dotfiles command> ')" || return
      printf '%s\n' "$selection" | format_catalog
      return
      ;;
  esac

  query="$*"
  if [[ -n "$query" ]]; then
    command_catalog "$readme" | awk -F '\t' -v query="$query" '
      BEGIN { query = tolower(query) }
      index(tolower($0), query) { print }
    ' | format_catalog
  else
    command_catalog "$readme" | format_catalog
  fi
}

main "$@"
